# ==========================================================
# DisasterWatch Full-Stack Environment Configuration
# ==========================================================
# Phase 1: Zero configuration required! Live USGS feeds & ESRI basemap are active.

# ----------------------------------------------------------
# Phase 2+ Backend Configuration (Spring Boot + PostGIS)
# ----------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL + PostGIS Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disasterwatch
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Google Gemini AI Integration (Backend Only - Rule 1.3)
GEMINI_API_KEY=your_google_gemini_api_key_here

# JWT Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# ----------------------------------------------------------
# Frontend Configuration (Next.js)
# ----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SSE_STREAM_URL=http://localhost:8080/api/v1/stream/events
